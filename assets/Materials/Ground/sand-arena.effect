CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: legacy/main-functions/general-vs:vert
      frag: sand-arena-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: true
      properties:
        mainColor:     { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
        darkColor:     { value: [0.66, 0.55, 0.38, 1.0], editor: { type: color } }
        lightColor:    { value: [0.87, 0.77, 0.61, 1.0], editor: { type: color } }
        brightness:    { value: 1.0, editor: { range: [0.5, 1.5, 0.01], slide: true } }
        macroScale:    { value: 0.19, editor: { range: [0.03, 0.5, 0.01], slide: true } }
        detailScale:   { value: 2.0, editor: { range: [0.3, 4.0, 0.05], slide: true } }
        grainScale:    { value: 20.0, editor: { range: [2.0, 20.0, 0.25], slide: true } }
        grainStrength: { value: 0.15, editor: { range: [0.0, 0.3, 0.01], slide: true } }
}%

CCProgram sand-arena-fs %{
  precision highp float;
  #include <legacy/output>
  #include <legacy/fog-fs>

  in vec3 v_position;

  uniform Constant {
    vec4 mainColor;
    vec4 darkColor;
    vec4 lightColor;
    float brightness;
    float macroScale;
    float detailScale;
    float grainScale;
    float grainStrength;
  };

  float sandHash (vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  float sandNoise (vec2 p) {
    vec2 cell = floor(p);
    vec2 local = fract(p);
    vec2 blend = local * local * (3.0 - 2.0 * local);

    float a = sandHash(cell);
    float b = sandHash(cell + vec2(1.0, 0.0));
    float c = sandHash(cell + vec2(0.0, 1.0));
    float d = sandHash(cell + vec2(1.0, 1.0));
    return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
  }

  float sandFbm (vec2 p) {
    float value = 0.0;
    float weight = 0.5;
    for (int octave = 0; octave < 3; octave++) {
      value += sandNoise(p) * weight;
      p = p * 2.03 + vec2(17.17, -9.41);
      weight *= 0.5;
    }
    return value / 0.875;
  }

  float sandStrokes (vec2 p) {
    vec2 cell = floor(p);
    vec2 local = fract(p) - 0.5;
    float seed = sandHash(cell + vec2(31.7, 11.3));
    float direction = step(0.5, sandHash(cell + vec2(4.1, 19.7))) * 2.0 - 1.0;

    float strokeA = (1.0 - smoothstep(0.025, 0.065, abs(local.x + local.y * 0.34 * direction)))
      * (1.0 - smoothstep(0.08, 0.30, abs(local.y)));
    float strokeB = (1.0 - smoothstep(0.025, 0.065, abs(local.x - 0.12 - local.y * 0.28 * direction)))
      * (1.0 - smoothstep(0.07, 0.23, abs(local.y + 0.04)));
    return max(strokeA, strokeB) * smoothstep(0.72, 0.9, seed);
  }

  vec4 frag () {
    // Match the grass material's world-space pattern so differently scaled
    // arena meshes keep one continuous texture density.
    vec2 world = v_position.xz;
    float macro = sandFbm(world * macroScale + vec2(8.317, 3.971));
    float detail = sandNoise(world * detailScale + vec2(21.7, -14.2));
    float grain = sandNoise(world * grainScale + vec2(-7.3, 12.9));
    float strokes = sandStrokes(world * grainScale * 0.55);

    float tone = clamp(0.52 + (macro - 0.5) * 0.72 + (detail - 0.5) * 0.20, 0.0, 1.0);
    vec3 sand = mix(darkColor.rgb, lightColor.rgb, tone);
    sand *= 1.0 + (grain - 0.5) * grainStrength;
    sand = mix(sand, darkColor.rgb * 0.92, strokes * 0.28);

    vec4 color = vec4(sand * mainColor.rgb * brightness, 1.0);
    CC_APPLY_FOG(color, v_position);
    return CCFragOutput(color);
  }
}%
