CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: legacy/main-functions/general-vs:vert
      frag: sand-arena-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainColor:       { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
        darkColor:       { value: [0.74, 0.58, 0.36, 1.0], editor: { type: color } }
        lightColor:      { value: [0.92, 0.79, 0.55, 1.0], editor: { type: color } }
        brightness:      { value: 1.03, editor: { range: [0.5, 1.5, 0.01], slide: true } }
        macroScale:      { value: 0.14, editor: { range: [0.03, 0.5, 0.01], slide: true } }
        detailScale:     { value: 1.15, editor: { range: [0.3, 4.0, 0.05], slide: true } }
        grainScale:      { value: 5.5, editor: { range: [2.0, 20.0, 0.25], slide: true } }
        grainStrength:   { value: 0.08, editor: { range: [0.0, 0.3, 0.01], slide: true } }
        surfaceSize:     { value: 20.0, editor: { range: [1.0, 100.0, 0.5], slide: true, tooltip: "World-space width of the square plane." } }
        circleRadius:    { value: 9.35, editor: { range: [0.1, 50.0, 0.05], slide: true, tooltip: "Arena radius in world units." } }
        edgeRoughness:   { value: 0.65, editor: { range: [0.0, 2.0, 0.05], slide: true } }
        edgeNoiseScale:  { value: 0.42, editor: { range: [0.05, 2.0, 0.01], slide: true } }
        edgeFeather:     { value: 0.08, editor: { range: [0.0, 0.5, 0.01], slide: true } }
        gapDepth:        { value: 1.15, editor: { range: [0.0, 4.0, 0.05], slide: true } }
        gapScale:        { value: 1.3, editor: { range: [0.1, 5.0, 0.05], slide: true } }
        gapThreshold:    { value: 0.72, editor: { range: [0.4, 0.95, 0.01], slide: true } }
        gapStrength:     { value: 1.0, editor: { range: [0.0, 1.0, 0.01], slide: true } }
}%

CCProgram sand-arena-fs %{
  precision highp float;
  #include <legacy/output>
  #include <legacy/fog-fs>

  in vec2 v_uv;
  in vec3 v_position;

  uniform Constant {
    vec4 mainColor;
    vec4 darkColor;
    vec4 lightColor;
    float brightness;
    float macroScale;
    float detailScale;
    float grainScale;
    float grainStrength;
    float surfaceSize;
    float circleRadius;
    float edgeRoughness;
    float edgeNoiseScale;
    float edgeFeather;
    float gapDepth;
    float gapScale;
    float gapThreshold;
    float gapStrength;
  };

  float sandHash (vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  float sandNoise (vec2 p) {
    vec2 cell = floor(p);
    vec2 local = fract(p);
    vec2 blend = local * local * (3.0 - 2.0 * local);

    float a = sandHash(cell);
    float b = sandHash(cell + vec2(1.0, 0.0));
    float c = sandHash(cell + vec2(0.0, 1.0));
    float d = sandHash(cell + vec2(1.0, 1.0));
    return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
  }

  float sandFbm (vec2 p) {
    float value = 0.0;
    float weight = 0.5;
    for (int octave = 0; octave < 3; octave++) {
      value += sandNoise(p) * weight;
      p = p * 2.03 + vec2(17.17, -9.41);
      weight *= 0.5;
    }
    return value / 0.875;
  }

  vec4 frag () {
    vec2 world = v_position.xz;

    float macro = sandFbm(world * macroScale + vec2(8.317, 3.971));
    float detail = sandNoise(world * detailScale + vec2(21.7, -14.2));
    float grain = sandNoise(world * grainScale + vec2(-7.3, 12.9));
    float sandTone = clamp(0.52 + (macro - 0.5) * 0.58 + (detail - 0.5) * 0.16, 0.0, 1.0);
    vec3 sand = mix(darkColor.rgb, lightColor.rgb, sandTone);
    sand *= 1.0 + (grain - 0.5) * grainStrength;

    // v_uv defines the circle around the centre of each plane, while all edge
    // noise is sampled in world space. Identical materials therefore produce
    // different silhouettes when their nodes stand at different coordinates.
    vec2 local = (v_uv - vec2(0.5)) * surfaceSize;
    float distanceFromCentre = length(local);
    float edgeNoise = sandFbm(world * edgeNoiseScale + vec2(37.91, -18.47));
    float irregularRadius = max(0.0, circleRadius + (edgeNoise - 0.5) * edgeRoughness * 2.0);
    float safeFeather = max(0.001, edgeFeather);
    float circleAlpha = 1.0 - smoothstep(
      irregularRadius - safeFeather,
      irregularRadius + safeFeather,
      distanceFromCentre
    );

    // Sparse high-frequency islands bite into the outer band and create fully
    // transparent gaps instead of a mechanically perfect continuous rim.
    float safeGapDepth = max(0.001, gapDepth);
    float edgeBand = smoothstep(
      circleRadius - safeGapDepth,
      circleRadius - safeGapDepth * 0.12,
      distanceFromCentre
    );
    float broadGap = sandFbm(world * gapScale + vec2(-51.7, 28.3));
    float chipGap = sandNoise(world * gapScale * 2.37 + vec2(11.2, 73.4));
    float gapNoise = max(broadGap, chipGap * 0.94);
    float gapMask = smoothstep(gapThreshold, min(0.995, gapThreshold + 0.09), gapNoise) * edgeBand;
    float alpha = circleAlpha * (1.0 - gapMask * gapStrength) * mainColor.a;

    vec4 color = vec4(sand * mainColor.rgb * brightness, alpha);
    CC_APPLY_FOG(color, v_position);
    return CCFragOutput(color);
  }
}%
